                li.style.marginBottom = "10px";
                li.style.fontWeight = "700";
                li.innerText = f;
                featList.appendChild(li);
            });

            document.getElementById('detail-cta-btn').onclick = () => openOrder(data.name);

            gsap.to("#detail-page", { left: 0, duration: 0.8, ease: "power3.inOut" });
